(() => {
  const canvas = document.getElementById("sparkyHologramCanvas");
  if (!canvas) return;

  const ctx = canvas.getContext("2d");
  const panel = document.getElementById("sparkyHologram");
  const status = document.getElementById("hologramStatus");

  let w = 0, h = 0, frame = 0;
  let state = "idle";
  let particles = [];

  function resize() {
    const rect = canvas.getBoundingClientRect();
    const ratio = Math.min(devicePixelRatio || 1, 2);
    w = rect.width;
    h = rect.height;
    canvas.width = w * ratio;
    canvas.height = h * ratio;
    ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

    particles = Array.from({length: 180}, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: Math.random() * 2 + .5,
      p: Math.random() * 6.28
    }));
  }

  function setState(next) {
    state = next;
    panel.classList.remove("listening", "thinking", "speaking");
    if (next !== "idle") panel.classList.add(next);

    status.textContent = ({
      idle: "MEGA CHARIZARD X • ONLINE",
      listening: "DRAGON LISTENING...",
      thinking: "DRAGON THINKING...",
      speaking: "DRAGON SPEAKING..."
    })[next] || "ONLINE";
  }

  function glow(color, blur) {
    ctx.shadowColor = color;
    ctx.shadowBlur = blur;
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
  }

  function drawDragon(cx, cy) {
    const breath = Math.sin(frame * 3) * 3;
    const flap = Math.sin(frame * 2) * 13;
    ctx.save();
    ctx.translate(cx, cy + breath);

    // Wings
    glow("#00bfff", 22);
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(-15, -35);
    ctx.quadraticCurveTo(-95, -125 - flap, -145, -70);
    ctx.quadraticCurveTo(-105, -15, -35, 10);
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(15, -35);
    ctx.quadraticCurveTo(95, -125 - flap, 145, -70);
    ctx.quadraticCurveTo(105, -15, 35, 10);
    ctx.stroke();

    // Dragon body
    glow("#18dfff", 25);
    ctx.lineWidth = 5;
    ctx.beginPath();
    ctx.ellipse(0, 10, 30, 55, 0, 0, Math.PI * 2);
    ctx.stroke();

    // Neck and head
    ctx.beginPath();
    ctx.moveTo(-10, -25);
    ctx.lineTo(-20, -65);
    ctx.lineTo(-35, -85);
    ctx.lineTo(-12, -105);
    ctx.lineTo(25, -92);
    ctx.lineTo(35, -68);
    ctx.lineTo(12, -48);
    ctx.stroke();

    // Horns
    ctx.beginPath();
    ctx.moveTo(-25, -90);
    ctx.lineTo(-42, -120);
    ctx.moveTo(15, -95);
    ctx.lineTo(28, -125);
    ctx.stroke();

    // Blue eyes
    glow("#ffffff", 20);
    ctx.fillRect(-23, -86, 7, 4);
    ctx.fillRect(10, -86, 7, 4);

    // Mouth movement
    // Animated dragon jaw and speaking mouth
    const talking = state === "speaking";
    const jawOpen = talking ? 4 + Math.abs(Math.sin(frame * 12)) * 13 : 1;

    ctx.beginPath();
    ctx.moveTo(-18, -69);
    ctx.quadraticCurveTo(0, -69 + jawOpen, 18, -69);
    ctx.stroke();

    if (talking) {
      glow("#00cfff", 16);
      ctx.beginPath();
      ctx.ellipse(0, -66 + jawOpen * .45, 8, jawOpen * .38, 0, 0, Math.PI * 2);
      ctx.fill();
    }

    // Dynamic blue fire breath while SPARKY speaks
    if (state === "speaking") {
      ctx.save();
      glow("#00cfff", 30);
      const fire = 18 + Math.abs(Math.sin(frame * 15)) * 18;
      ctx.beginPath();
      ctx.moveTo(22, -68);
      ctx.quadraticCurveTo(45 + fire, -78, 65 + fire, -65);
      ctx.quadraticCurveTo(45 + fire, -55, 22, -64);
      ctx.fillStyle = "#00cfff";
      ctx.fill();
      ctx.restore();
    }

    // Tail
    ctx.beginPath();
    ctx.moveTo(20, 48);
    ctx.quadraticCurveTo(85, 80, 60, 125);
    ctx.stroke();

    // Blue flame
    glow("#00cfff", 30);
    ctx.beginPath();
    ctx.moveTo(60, 125);
    ctx.quadraticCurveTo(25, 105, 62, 82);
    ctx.quadraticCurveTo(100, 105, 60, 125);
    ctx.fill();

    // Arms
    ctx.beginPath();
    ctx.moveTo(-25, -5);
    ctx.lineTo(-58, 25);
    ctx.lineTo(-38, 43);
    ctx.moveTo(25, -5);
    ctx.lineTo(58, 25);
    ctx.lineTo(38, 43);
    ctx.stroke();

    ctx.restore();
  }

  function draw() {
    frame += .025;
    ctx.clearRect(0, 0, w, h);

    const cx = w / 2;
    const cy = h / 2;

    // Energy glow
    const aura = ctx.createRadialGradient(cx, cy, 5, cx, cy, 190);
    aura.addColorStop(0, "rgba(0,180,255,.22)");
    aura.addColorStop(1, "rgba(0,50,255,0)");
    ctx.fillStyle = aura;
    ctx.fillRect(0, 0, w, h);

    // Floating particles
    for (const p of particles) {
      p.y -= .35;
      if (p.y < 0) p.y = h;
      ctx.beginPath();
      ctx.arc(p.x, p.y + Math.sin(frame + p.p) * 5, p.r, 0, 6.28);
      ctx.fillStyle = "rgba(30,210,255,.8)";
      ctx.shadowColor = "#00cfff";
      ctx.shadowBlur = 10;
      ctx.fill();
    }

    // Projector rings
    ctx.save();
    ctx.translate(cx, cy + 120);
    ctx.rotate(frame);
    glow("#00d9ff", 20);
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.ellipse(0, 0, 125, 23, 0, 0, 6.28);
    ctx.stroke();
    ctx.restore();

    drawDragon(cx, cy);

    ctx.shadowBlur = 0;
    requestAnimationFrame(draw);
  }

  window.SparkyHologram = {setState};
  resize();
  addEventListener("resize", resize);
  setState("idle");
  draw();
})();
