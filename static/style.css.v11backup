:root {
  --bg: #030914;
  --panel: rgba(7, 22, 39, .94);
  --panel2: rgba(9, 30, 49, .88);
  --line: rgba(48, 207, 255, .25);
  --cyan: #42dcff;
  --cyan2: #00aaff;
  --orange: #ff8a24;
  --text: #e8f8ff;
  --muted: #83a7ba;
  --red: #ff536b;
  --green: #46f5b0;
}

* { box-sizing: border-box; }

html { min-height: 100%; scroll-behavior: smooth; }

body {
  margin: 0;
  min-height: 100vh;
  color: var(--text);
  background:
    radial-gradient(ellipse at 50% 35%, rgba(0, 110, 160, .17), transparent 45%),
    radial-gradient(ellipse at 5% 90%, rgba(0, 70, 110, .14), transparent 35%),
    linear-gradient(145deg, #020711, #061426 55%, #020812);
  font-family: "Segoe UI", Roboto, Arial, sans-serif;
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: .2;
  background-image:
    linear-gradient(rgba(40, 190, 230, .07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(40, 190, 230, .07) 1px, transparent 1px);
  background-size: 42px 42px;
}

button, input, textarea { font: inherit; }

button {
  color: var(--cyan);
  background: linear-gradient(145deg, rgba(9, 39, 60, .95), rgba(4, 19, 34, .95));
  border: 1px solid rgba(58, 210, 255, .38);
  border-radius: 9px;
  padding: 10px 13px;
  cursor: pointer;
  transition: .2s ease;
  box-shadow: inset 0 0 12px rgba(0, 170, 255, .04);
}

button:hover {
  border-color: var(--cyan);
  background: rgba(0, 120, 170, .25);
  box-shadow: 0 0 15px rgba(0, 190, 255, .18);
  transform: translateY(-1px);
}

button:active { transform: scale(.97); }

input {
  color: var(--text);
  background: rgba(1, 12, 24, .9);
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 12px;
  outline: none;
  min-width: 0;
}

input:focus {
  border-color: var(--cyan);
  box-shadow: 0 0 12px rgba(0, 190, 255, .13);
}

input::placeholder { color: #668397; }

.shell {
  width: min(1800px, 100%);
  margin: auto;
  padding: 16px 20px 22px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding: 12px 18px;
  margin-bottom: 18px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(5, 19, 34, .82);
  box-shadow: 0 8px 35px rgba(0, 0, 0, .28);
}

.brand { display: flex; align-items: center; gap: 12px; }
.brand b { display: block; font-size: 22px; letter-spacing: 4px; color: var(--cyan); }
.brand small { display: block; margin-top: 3px; color: var(--muted); font-size: 9px; letter-spacing: 2px; }

.orb {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border: 1px solid var(--cyan);
  border-radius: 50%;
  color: white;
  font-size: 22px;
  font-weight: 800;
  background: radial-gradient(circle, #087caa, #04172b 70%);
  box-shadow: 0 0 18px rgba(0, 200, 255, .45);
}

.status-pill, .tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--line);
  border-radius: 30px;
  padding: 8px 12px;
  color: var(--green);
  background: rgba(0, 70, 65, .15);
  font-size: 10px;
  letter-spacing: 1.3px;
  white-space: nowrap;
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 10px var(--green);
}

.dashboard-layout {
  display: grid;
  grid-template-columns: minmax(210px, .82fr) minmax(350px, 1.65fr) minmax(230px, .9fr);
  gap: 16px;
  align-items: start;
}

.left-rail, .right-rail, .center-stage {
  display: flex;
  flex-direction: column;
  gap: 15px;
  min-width: 0;
}

.panel {
  min-width: 0;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: linear-gradient(145deg, var(--panel2), var(--panel));
  box-shadow: 0 8px 28px rgba(0, 0, 0, .24), inset 0 0 20px rgba(0, 170, 255, .025);
  backdrop-filter: blur(12px);
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.eyebrow {
  display: block;
  margin-bottom: 5px;
  color: var(--cyan);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 2px;
}

h2 {
  margin: 0;
  color: #e8f8ff;
  font-size: 16px;
  font-weight: 650;
}

h3 { color: var(--cyan); }

.actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.actions button {
  min-height: 42px;
  padding: 8px 5px;
  font-size: 11px;
  overflow-wrap: anywhere;
}

button.warn {
  color: #ff8291;
  border-color: rgba(255, 83, 107, .35);
  background: rgba(80, 15, 30, .28);
}

.center-stage {
  align-items: stretch;
  justify-content: center;
  min-width: 0;
}

.sparky-hologram {
  width: 100%;
  min-height: 450px;
  overflow: hidden;
  position: relative;
  border: 1px solid rgba(48, 207, 255, .42);
  border-radius: 18px;
  background: radial-gradient(ellipse at 50% 65%, #0b2940 0%, #061426 48%, #020914 100%);
  box-shadow: 0 0 35px rgba(0, 160, 220, .13), inset 0 0 45px rgba(0, 150, 220, .1);
}

.voice-controls {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 9px;
}

.voice-controls button {
  flex: 1 1 105px;
  min-height: 43px;
  font-size: 11px;
  font-weight: 700;
}

#callBtn {
  color: #fff;
  border-color: rgba(255, 125, 45, .65);
  background: linear-gradient(135deg, #a94716, #51200f);
}

.voice-status {
  text-align: center;
  padding: 10px;
  border: 1px solid rgba(48, 207, 255, .16);
  border-radius: 10px;
  background: rgba(3, 18, 32, .65);
}

.voice-status h3 { margin: 0 0 5px; font-size: 13px; }
.voice-status p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.5; }

.metrics { display: grid; gap: 13px; }

.metric {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 6px 10px;
  align-items: center;
}

.metric small { color: var(--muted); font-size: 10px; }
.metric b { color: var(--cyan); font-size: 12px; }
.metric .bar { grid-column: 1 / -1; }

.bar {
  height: 6px;
  overflow: hidden;
  border-radius: 10px;
  background: #102b3e;
}

.bar i {
  display: block;
  width: 0;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #00a9db, #54edff);
  box-shadow: 0 0 9px var(--cyan);
}

.substatus {
  display: flex;
  justify-content: space-between;
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px solid var(--line);
  color: var(--muted);
  font-size: 11px;
}

.substatus b { color: var(--green); }

.refresh { padding: 6px 11px; font-size: 17px; }

.notification-controls, .sms-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-bottom: 10px;
}

.notification-controls button, .sms-controls button {
  flex: 1 1 100px;
  font-size: 10px;
  padding: 9px 6px;
}

.info-result {
  max-height: 240px;
  overflow-y: auto;
  padding: 11px;
  border: 1px solid rgba(48, 207, 255, .14);
  border-radius: 9px;
  color: #a9c8d8;
  background: rgba(1, 12, 23, .55);
  font-size: 11px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.weather-form { display: flex; gap: 7px; margin-bottom: 10px; }
.weather-form input { flex: 1; width: 50%; }
.weather-form button { font-size: 10px; }

.bottom-grid {
  display: grid;
  grid-template-columns: minmax(280px, 1.5fr) minmax(220px, .8fr) minmax(220px, .8fr);
  gap: 16px;
  margin-top: 17px;
  align-items: stretch;
}

.chat-panel { display: flex; flex-direction: column; min-height: 410px; }

.chat-log {
  flex: 1;
  min-height: 220px;
  max-height: 390px;
  overflow-y: auto;
  padding: 12px;
  border: 1px solid rgba(48, 207, 255, .15);
  border-radius: 10px;
  background: rgba(1, 10, 21, .65);
}

.bubble {
  width: fit-content;
  max-width: 90%;
  margin: 8px 0;
  padding: 11px 13px;
  border-radius: 12px;
  font-size: 12px;
  line-height: 1.55;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.bubble.bot {
  color: #d8f4ff;
  border: 1px solid rgba(48, 207, 255, .22);
  background: rgba(0, 94, 130, .2);
}

.bubble.user {
  margin-left: auto;
  color: white;
  border: 1px solid rgba(255, 138, 36, .3);
  background: rgba(130, 65, 18, .24);
}

.composer-tools {
  display: flex;
  gap: 8px;
  margin: 10px 0 6px;
}

.composer-tools button { min-width: 40px; padding: 8px; }

.hint { color: var(--muted); font-size: 10px; overflow-wrap: anywhere; }

.composer { display: flex; gap: 8px; margin-top: 8px; }
.composer input { flex: 1; width: 50%; }
.composer button { min-width: 75px; font-weight: 700; }

.news-list, .chat-history-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
  color: #b7d0dd;
  font-size: 11px;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.news-list a { color: var(--cyan); }

.menu-btn {
  position: fixed;
  z-index: 50;
  top: 14px;
  left: 12px;
  display: none;
}

.chat-sidebar {
  position: fixed;
  z-index: 60;
  top: 0;
  bottom: 0;
  left: 0;
  width: min(320px, 85vw);
  padding: 18px;
  overflow-y: auto;
  background: #061426;
  border-right: 1px solid var(--line);
  transform: translateX(-105%);
  transition: transform .25s ease;
}

.chat-sidebar.open { transform: translateX(0); }

.sidebar-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; color: var(--cyan); }
.new-chat-btn { width: 100%; margin-bottom: 15px; }

.sidebar-overlay {
  display: none;
  position: fixed;
  z-index: 55;
  inset: 0;
  background: rgba(0, 0, 0, .65);
}

.sidebar-overlay.show { display: block; }

.toast {
  position: fixed;
  z-index: 100;
  bottom: 18px;
  left: 50%;
  max-width: 90%;
  padding: 11px 17px;
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--text);
  background: #09223a;
  box-shadow: 0 0 20px rgba(0, 170, 255, .2);
  transform: translate(-50%, 150%);
  transition: transform .25s ease;
}

.toast.show { transform: translate(-50%, 0); }

footer {
  padding: 20px 5px 5px;
  text-align: center;
  color: #58798c;
  font-size: 9px;
  letter-spacing: 2px;
}

@media (max-width: 1050px) {
  .dashboard-layout {
    grid-template-columns: minmax(180px, .8fr) minmax(300px, 1.4fr);
  }
  .right-rail { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .bottom-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .chat-panel { grid-column: 1 / -1; }
}

@media (max-width: 700px) {
  .shell { padding: 10px; }
  .topbar { margin-left: 38px; padding: 10px; }
  .brand b { font-size: 18px; }
  .brand small { font-size: 8px; letter-spacing: 1px; }
  .orb { width: 36px; height: 36px; }
  .status-pill { padding: 7px; font-size: 8px; }
  .menu-btn { display: block; }
  .dashboard-layout { grid-template-columns: 1fr; gap: 12px; }
  .center-stage { grid-row: 1; }
  .left-rail { grid-row: 2; }
  .right-rail { grid-row: 3; display: flex; }
  .sparky-hologram { min-height: 340px; }
  .bottom-grid { grid-template-columns: 1fr; gap: 12px; margin-top: 12px; }
  .chat-panel { grid-column: auto; min-height: 380px; }
  .panel { padding: 13px; }
  .actions button { min-height: 40px; }
}

@media (max-width: 380px) {
  .status-pill { font-size: 7px; }
  .brand small { letter-spacing: 0; }
  .sparky-hologram { min-height: 290px; }
  .voice-controls button { flex-basis: 100%; }
}
